{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RSA benchmark author report",
  "description": "Measurements only. Execution identity and metadata belong to the benchmark context.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metrics": {
      "type": "object", "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/definitions/metric"}
    },
    "checks": {
      "type": "object", "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/definitions/check"}
    }
  },
  "definitions": {
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": ["number", "null"]},
        "unit": {"type": "string", "minLength": 1},
        "direction": {"enum": ["lower", "higher", "none"]},
        "label": {"type": "string"},
        "reason": {"type": "string"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["passed"],
      "properties": {
        "passed": {"type": ["boolean", "null"]},
        "label": {"type": "string"},
        "expected": {},
        "actual": {},
        "evidenceSeq": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}},
        "evidenceEvents": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
