{
  "name": "@playness/rsa",
  "private": true,
  "type": "module",
  "scripts": {
    "rsa": "bun src/app/main.ts",
    "test": "bun run test:typescript && bun run test:python",
    "test:transport": "bun test tests/omp-websocket.test.ts",
    "check": "bun run check:typescript && bun run check:python",
    "test:typescript": "uv run --project python --frozen bun test",
    "test:python": "uv run --project python --frozen python scripts/test-python.py",
    "check:typescript": "tsc --noEmit",
    "check:python": "uv run --project python --frozen mypy --config-file python/pyproject.toml python/rsa_tools"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@oh-my-pi/omptype": "18.9.1",
    "@oh-my-pi/pi-agent-core": "18.9.1",
    "@oh-my-pi/pi-ai": "18.9.1",
    "@oh-my-pi/pi-catalog": "18.9.1",
    "@oh-my-pi/pi-coding-agent": "18.9.1",
    "@oh-my-pi/pi-utils": "18.9.1",
    "@oh-my-pi/snapcompact": "18.9.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@playness/baseware": "file:../baseware",
    "ajv": "8",
    "ignore": "^7.0.14",
    "smol-toml": "^1.9.1"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-ai@18.9.1": "patches/@oh-my-pi%2Fpi-ai@18.9.1.patch",
    "@oh-my-pi/pi-coding-agent@18.9.1": "patches/@oh-my-pi%2Fpi-coding-agent@18.9.1.patch",
    "@oh-my-pi/pi-agent-core@18.9.1": "patches/@oh-my-pi%2Fpi-agent-core@18.9.1.patch"
  }
}
