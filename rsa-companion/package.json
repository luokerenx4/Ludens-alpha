{
  "name": "@ludens/rsa-companion",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pet:preview": "npm run build && electron dist/electron/companion-preview.js",
    "pet:smoke": "npm run build && electron dist/electron/companion-preview.js --smoke",
    "start": "electron dist/electron/main.js"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "electron": "39.8.10",
    "esbuild": "0.25.12",
    "jsdom": "29.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@11.19.0"
}
