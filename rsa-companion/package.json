  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
