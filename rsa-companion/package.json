{
  "name": "rsa-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:native",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "npm run build:native && electron dist/electron/companion-preview.js",
    "smoke": "npm run build:native && electron dist/electron/companion-preview.js --smoke",
    "start": "electron dist/electron/main.js"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "electron": "39.8.10",
    "esbuild": "0.25.12",
    "jsdom": "29.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "packageManager": "pnpm@11.19.0"
}
